@model Dbfirst.Models.Cow

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Cow</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CowName" class="control-label"></label>
                <input asp-for="CowName" class="form-control" />
                <span asp-validation-for="CowName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CowDesc" class="control-label"></label>
                <input asp-for="CowDesc" class="form-control" />
                <span asp-validation-for="CowDesc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CowImage" class="control-label"></label>
                <input type="file" name="file" class="form-control" />
                <span asp-validation-for="CowImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CowPrice" class="control-label"></label>
                <input asp-for="CowPrice" class="form-control" />
                <span asp-validation-for="CowPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CatId" class="control-label"></label>
                <select asp-for="CatId" class ="form-control" asp-items="ViewBag.CatId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
