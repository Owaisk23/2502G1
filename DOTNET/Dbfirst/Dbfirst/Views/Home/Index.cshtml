@model IEnumerable<Dbfirst.Models.Cow>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CowName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CowDesc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CowImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CowPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cat)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CowName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CowDesc)
            </td>
                <td>
                    <img src="@Html.DisplayFor(modelItem => item.CowImage)" width="40" height="40" class="rounded-circle" />
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.CowPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cat.CatId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CowId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CowId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CowId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
