@model IEnumerable<Dbfirst.Models.Cow>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="AddProduct">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CowName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CowDesc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CowPrice)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CowName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CowDesc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CowPrice)
            </td>
            <td>
                <a asp-action="EditProduct" asp-route-id="@item.CowId">Edit</a> |
                <a asp-action="DetailProduct" asp-route-id="@item.CowId">Details</a> |
                    <a asp-action="DeleteProduct" asp-route-id="@item.CowId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
